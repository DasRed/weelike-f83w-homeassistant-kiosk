####################################
# F83W (Weelikeit, Allwinner A133)
# The panel is 800x1280 portrait; stock rotates via the Allwinner prop ro.vendor.sf.rotation=90.
# AOSP equivalent, so landscape is the default orientation:
####################################
ro.surface_flinger.primary_display_orientation=ORIENTATION_90
# No navigation bar (wall panel without back/home/recents)
qemu.hw.mainkeys=1
persist.sys.phh.mainkeys=1
